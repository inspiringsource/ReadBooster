{
  "name": "readbooster",
  "private": true,
  "version": "0.7.5",
  "license": "MPL-2.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build.mjs",
    "build:chrome": "node scripts/build.mjs chrome",
    "build:firefox": "node scripts/build.mjs firefox",
    "verify:chrome": "node scripts/verify-build.mjs --target chrome --dist dist-chrome",
    "verify:firefox": "node scripts/verify-build.mjs --target firefox --dist dist-firefox",
    "lint:firefox": "web-ext lint --source-dir dist-firefox --no-input",
    "run:firefox": "web-ext run --source-dir dist-firefox",
    "package:chrome": "node scripts/package-release.mjs chrome",
    "package:firefox": "node scripts/package-release.mjs firefox",
    "package:source": "node scripts/package-release.mjs source",
    "verify:archives": "node scripts/verify-release-archives.mjs",
    "release": "node scripts/release.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:browser": "node scripts/test-fast-reading-rendering.mjs"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "highlight.js": "^11.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/chrome": "^0.3.4",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "pixelmatch": "^7.2.0",
    "playwright-core": "^1.63.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "web-ext": "^10.7.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  }
}
