{
  "name": "readbooster",
  "private": true,
  "version": "0.6.9",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build.mjs",
    "build:chrome": "node scripts/build.mjs chrome",
    "build:firefox": "node scripts/build.mjs firefox",
    "verify:chrome": "node scripts/verify-build.mjs --target chrome --dist dist-chrome",
    "verify:firefox": "node scripts/verify-build.mjs --target firefox --dist dist-firefox",
    "lint:firefox": "web-ext lint --source-dir dist-firefox --no-input",
    "run:firefox": "web-ext run --source-dir dist-firefox",
    "package:chrome": "node scripts/package-release.mjs chrome",
    "package:firefox": "node scripts/package-release.mjs firefox",
    "package:source": "node scripts/package-release.mjs source",
    "verify:archives": "node scripts/verify-release-archives.mjs",
    "release": "node scripts/release.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:browser": "node scripts/test-fast-reading-rendering.mjs"
  },
  "dependencies": {
    "dompurify": "^3.4.12",
    "highlight.js": "^11.11.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/chrome": "^0.2.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "pixelmatch": "^7.2.0",
    "playwright-core": "^1.61.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "web-ext": "^10.5.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  }
}
